{
  "name": "gestionespese1",
  "main": "backend/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestione-spese-db",
      "database_id": "65199f83-c748-47cd-9b20-0fa3dcb62a6f",
      "migrations_dir": "database/migrations"
    }
  ],
  "observability": { "enabled": true }
}
